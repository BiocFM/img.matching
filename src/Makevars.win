# Makevars.win for img.matching (Windows, Rtools)
# Part 1: OpenCV  -- adapted from ropensci/opencv (Rtools pkg-config or tools/winlibs.R)
# LibTorch is NOT linked: it is used through R torch's Lantern C API
# (LinkingTo: torch provides lantern/lantern.h, see src/torch_lantern.cpp)

CXX_STD = CXX17

# ---------------------------------------------------------------------------
# Part 1: OpenCV
# ---------------------------------------------------------------------------
PKG_CONFIG_NAME = opencv4
PKG_CONFIG ?= $(BINPREF)pkg-config
OPENCV_PC_LIBS := $(shell $(PKG_CONFIG) --libs $(PKG_CONFIG_NAME))

ifneq ($(findstring opencv_core,$(OPENCV_PC_LIBS)),)
$(info using $(PKG_CONFIG_NAME) from Rtools)
OPENCV_CFLAGS := $(shell $(PKG_CONFIG) --cflags $(PKG_CONFIG_NAME))
OPENCV_LIBS := $(OPENCV_PC_LIBS)
else
RWINLIB = ../.deps/opencv
OPENCV_CFLAGS = -I$(RWINLIB)/include/opencv4
OLDLIBDIR = lib${subst gcc,,${COMPILED_BY}}${R_ARCH}
OPENCV_LIBS = \
	-L$(RWINLIB)/$(OLDLIBDIR) \
	-L$(RWINLIB)/lib \
	-lopencv_ml481 -lopencv_objdetect481 -lopencv_photo481 -lopencv_stitching481 -lopencv_wechat_qrcode481 -lopencv_dnn481 \
	-lopencv_video481 -lopencv_calib3d481 -lopencv_xfeatures2d481 -lopencv_features2d481 -lopencv_highgui481 -lopencv_flann481 \
	-lopencv_videoio481 -lopencv_imgcodecs481 -lopencv_imgproc481 -lopencv_core481 -llibopenjp2 -lquirc \
	-ljpeg -lwebp -lsharpyuv -lpng -lz -ltiff -lpthread -lgdi32 -lole32 -lopengl32 -lcomdlg32 -lOleAut32 -luuid
endif

# ---------------------------------------------------------------------------
# Combine
# ---------------------------------------------------------------------------
PKG_CPPFLAGS = $(OPENCV_CFLAGS)
PKG_LIBS = $(OPENCV_LIBS)

ifdef RWINLIB
$(OBJECTS): | $(RWINLIB)

$(RWINLIB):
	"$(R_HOME)/bin$(R_ARCH_BIN)/Rscript.exe" "../tools/winlibs.R"
endif
