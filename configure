#!/bin/sh
# configure for img.matching (Linux / macOS)
# Part 1: OpenCV  -- adapted from ropensci/opencv (Jeroen Ooms' anticonf script)
# LibTorch is NOT linked: it is used through R torch's Lantern C API
# (LinkingTo: torch provides lantern/lantern.h). The OpenCV flags are written into src/Makevars (from src/Makevars.in).

# ---------------------------------------------------------------------------
# Part 1: OpenCV
# ---------------------------------------------------------------------------
PKG_CONFIG_NAME="opencv4"
PKG_CONFIG_NAME_ALT="opencv5"
PKG_DEB_NAME="libopencv-dev"
PKG_RPM_NAME="opencv-devel"
PKG_BREW_NAME="opencv"
PKG_TEST_HEADER="<opencv2/opencv.hpp>"
OPENCV_LIBS="-lopencv_calib3d -lopencv_features2d -lopencv_flann -lopencv_imgproc -lopencv_core"

PCVERSION=`pkg-config --version 2>/dev/null`
if [ $? -eq 0 ]; then
  echo "This is pkg-config $PCVERSION"
  if pkg-config --exists ${PKG_CONFIG_NAME}; then
    PKGCONFIG_CFLAGS=`pkg-config --cflags ${PKG_CONFIG_NAME}`
    PKGCONFIG_LIBS=`pkg-config --libs ${PKG_CONFIG_NAME}`
  elif pkg-config --exists ${PKG_CONFIG_NAME_ALT}; then
    PKGCONFIG_CFLAGS=`pkg-config --cflags ${PKG_CONFIG_NAME_ALT}`
    PKGCONFIG_LIBS=`pkg-config --libs ${PKG_CONFIG_NAME_ALT}`
  fi
fi

if [ "$PKGCONFIG_CFLAGS" ] || [ "$PKGCONFIG_LIBS" ]; then
  echo "Found OpenCV via pkg-config"
  OPENCV_CFLAGS=${PKGCONFIG_CFLAGS}
  OPENCV_LIBS=${PKGCONFIG_LIBS}
elif [ `uname` = "Darwin" ]; then
  test ! "$CI" && brew --version 2>/dev/null
  if [ $? -eq 0 ]; then
    BREWDIR=`brew --prefix`
    OPENCV_CFLAGS="-I$BREWDIR/opt/opencv/include/opencv4"
    OPENCV_LIBS="-L$BREWDIR/opt/opencv/lib $OPENCV_LIBS"
  else
    curl -sfL "https://autobrew.github.io/scripts/opencv" > autobrew
    . ./autobrew
    OPENCV_CFLAGS="$PKG_CFLAGS"
    OPENCV_LIBS="$PKG_LIBS"
  fi
fi

# ---------------------------------------------------------------------------
# Combine and test
# ---------------------------------------------------------------------------
PKG_CFLAGS="$OPENCV_CFLAGS"
PKG_LIBS="$OPENCV_LIBS"

echo "Using PKG_CFLAGS=$PKG_CFLAGS"
echo "Using PKG_LIBS=$PKG_LIBS"

CXX=`"${R_HOME}/bin/R" CMD config CXX17`
CXX17STD=`"${R_HOME}/bin/R" CMD config CXX17STD`
CXXFLAGS=`"${R_HOME}/bin/R" CMD config CXX17FLAGS`
CPPFLAGS=`"${R_HOME}/bin/R" CMD config CPPFLAGS`

# Preprocess a file that includes both libraries, the same way src/ will
printf '#include <opencv2/opencv.hpp>\n' | \
  ${CXX} ${CXX17STD} -E ${CPPFLAGS} ${PKG_CFLAGS} ${CXXFLAGS} -xc++ - >/dev/null 2>configure.log

if [ $? -ne 0 ]; then
  echo "-----------------------------[ ANTICONF ]-------------------------------"
  echo "Configuration failed to include the OpenCV headers."
  echo "OpenCV: try installing"
  echo " * deb: $PKG_DEB_NAME (Debian, Ubuntu, etc)"
  echo " * rpm: $PKG_RPM_NAME (Fedora, CentOS, RHEL)"
  echo " * brew: $PKG_BREW_NAME (macOS)"
  echo "---------------------------[ ERROR MESSAGE ]----------------------------"
  cat configure.log
  echo "------------------------------------------------------------------------"
  exit 1
fi

# Write to Makevars
sed -e "s|@cflags@|$PKG_CFLAGS|" -e "s|@libs@|$PKG_LIBS|" src/Makevars.in > src/Makevars

exit 0
